{
  "id": "wxpay-login",
  "name": "微信支付商户登录页",
  "url": "https://pay.weixin.qq.com/index.php/core/home/login",
  "type": "form",
  "viewports": [
    { "name": "desktop", "width": 1280, "height": 800 }
  ],
  "wait": {
    "until": "domcontentloaded",
    "extra_ms": 2500
  },
  "features": [
    {
      "id": "username",
      "desc": "登录账号输入框，placeholder 为「登录账号」",
      "selector_hint": "#idUserName, input[name=username]",
      "type": "element"
    },
    {
      "id": "password",
      "desc": "登录密码输入框，type=password，placeholder 为「登录密码」",
      "selector_hint": "#idPassword, input[name=password]",
      "type": "element"
    },
    {
      "id": "captcha-input",
      "desc": "验证码输入框，placeholder 为「验证码」，右侧配验证码图片",
      "selector_hint": "input[name=checkword_in]",
      "type": "element"
    },
    {
      "id": "captcha-image",
      "desc": "验证码图片，点击可刷新",
      "selector_hint": "img[src*=captcha], .verify-code img",
      "type": "element"
    },
    {
      "id": "login-button",
      "desc": "登录按钮（账号登录），点击触发表单校验",
      "selector_hint": ".btn_login, a.login, button[type=submit]",
      "type": "element"
    },
    {
      "id": "fill-and-login",
      "desc": "依次填入账号、密码、验证码后点击登录，按钮可点且触发校验反馈",
      "type": "behavior",
      "steps": [
        { "action": "fill", "target": "username", "value": "merchant_demo" },
        { "action": "fill", "target": "password", "value": "Pass1234" },
        { "action": "fill", "target": "captcha-input", "value": "8888" },
        { "action": "click", "target": "login-button" }
      ]
    }
  ],
  "masks": [
    { "desc": "动态验证码图片（每次刷新都不同，遮罩避免污染视觉对比）", "selector": "img[src*=captcha], .verify-code img" }
  ],
  "notes": "表单交互型。题目指定仅复刻用户名/密码/验证码输入区与登录按钮点击交互。验证码为动态内容，已遮罩。"
}
