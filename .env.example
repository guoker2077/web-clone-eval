# Claude API 配置示例 —— 复制为 .env 并填入真实值
# 中转平台（如 nowcoding.ai）通常用 AUTH_TOKEN + BASE_URL；
# 官方 API 则用 ANTHROPIC_API_KEY，二者择一即可。
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://nowcoding.ai
ANTHROPIC_MODEL=claude-opus-4-8

# ── 云端服务加固（仅 web/worker 用；CLI 不读）──────────────────────────
# 公开到公网前务必设置 Basic Auth 账号密码，否则任何人都能消耗你的 Claude 额度。
# 本地调试可留空（留空=不启用鉴权）。
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# 强隔离（每 job 一次性容器）：设为 docker 启用，需给 worker 挂 docker.sock。
# 默认 subprocess（同容器 + setrlimit 软隔离），单机部署够用。
# SANDBOX_MODE=docker
