# Secrets — 绝不提交
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# 交付产物（复刻成果）：deliverables/<site>/dist 是「可独立运行的静态产物」，
# 需随仓库提交，故覆盖上面的全局 dist/ 忽略（source/ 已不含 node_modules）。
!deliverables/**/dist/
!deliverables/**/dist/**

# Playwright
.playwright/
playwright-report/

# 评估中间产物（截图体积大，按需保留）
output/**/node_modules/
output/**/.rounds/
output/**/.last_orphans.json
reports/**/*.tmp.png

# 服务端本地状态（队列 DB、worker 日志、数据卷）
server/jobs.db*
server/worker_logs/
data/

# OS / IDE
.DS_Store
.idea/
*.log

# 验收证据：run_logs 下的运行日志需随仓库提交（EVIDENCE.md 引用），覆盖 *.log
!run_logs/
!run_logs/**/*.log
run_logs/**/.lastid
